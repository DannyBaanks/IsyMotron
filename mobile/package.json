{
  "name": "isymotron-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IsyMotron M\u00f3vil: your phone pairs with your IsyMotron PC over Link. The PC keeps the authority; the phone is the human's hand.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
