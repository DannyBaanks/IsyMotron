{
  "name": "isymotron-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IsyMotron Móvil: your phone pairs with your IsyMotron PC over Link. The PC keeps the authority; the phone is the human's hand.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node tools/assert-gus-production.mjs",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview --host",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "e2e": "node e2e/pairing.e2e.mjs",
    "e2e:gus": "npm run build:e2e && node e2e/gus.e2e.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "^1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  }
}
