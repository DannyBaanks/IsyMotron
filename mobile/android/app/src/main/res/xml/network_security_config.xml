<?xml version="1.0" encoding="utf-8"?>
<!--
  The PC's IsyMotron Link server speaks plain HTTP on the local network: every call is
  signed and encrypted end to end (Ed25519 + X25519/AES-GCM) and only replies sealed by the
  paired PC are believed. Android cannot scope cleartext to private IP ranges, so the
  platform policy allows it here. The Link client validates every typed and stored
  destination as a private/loopback/link-local IP or a .local hostname before making a call.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
