# Sealed evidence must be byte-identical on every platform: the manifests in
# evidence/**/hashes.json are SHA-256 over the exact bytes. Git's end-of-line
# conversion (core.autocrlf on Windows) rewrites them on checkout and breaks
# every hash. Measured on windows-latest CI, 2026-09-22: run.txt hashed as
# a51562b9… (CRLF) instead of baf7d0c5… (LF).
#
# `-text` disables the conversion; the files stay diffable.
evidence/** -text

# The GUS runtime snapshot is pinned by SHA-256 over its exact bytes
# (mobile/vendor/gus-runtime/VENDOR.json). With core.autocrlf=true on Windows
# the checked-out bytes are CRLF and tests/gus-runtime-vendor.test.ts fails on
# a clean clone, even though the blob in Git is LF.
mobile/vendor/gus-runtime/** -text

# The catalogues below are generated byte-for-byte by
# tools/generate-gus-catalog.mjs and verified with --check, which compares the
# exact file contents. CRLF checkout breaks that check on Windows.
mobile/src/gus/catalog.generated.ts -text
mobile/android/app/src/main/java/io/github/dannybaanks/isymotron/GusCatalog.java -text
mobile/ios/App/GusLocal/Sources/GusLocalPlugin/GUSCatalog.generated.swift -text
