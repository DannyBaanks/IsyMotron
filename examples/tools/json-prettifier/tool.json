{
  "contract": "ToolContract/v1",
  "tool_id": "json-prettifier",
  "version": "1",
  "summary": "Format a JSON object into a declared artifact",
  "entrypoint": "main.py",
  "provider": "linux-python/v1",
  "input_schema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "keys": {
        "type": "integer"
      }
    },
    "required": [
      "keys"
    ],
    "additionalProperties": false
  },
  "effects": {
    "read": [
      "data.json"
    ],
    "write": [
      "pretty.json"
    ]
  }
}
