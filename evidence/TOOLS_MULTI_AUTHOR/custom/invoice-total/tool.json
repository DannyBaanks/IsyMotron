{
  "contract": "ToolContract/v1",
  "tool_id": "invoice-total",
  "version": "1",
  "summary": "Total invoice lines using integer cents",
  "entrypoint": "main.py",
  "provider": "linux-python/v1",
  "input_schema": {
    "type": "object",
    "properties": {
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "quantity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "unit_cents": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "quantity",
            "unit_cents"
          ],
          "additionalProperties": false
        },
        "maxItems": 100
      }
    },
    "required": [
      "lines"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "total_cents": {
        "type": "integer"
      },
      "items": {
        "type": "integer"
      }
    },
    "required": [
      "total_cents",
      "items"
    ],
    "additionalProperties": false
  },
  "effects": {
    "read": [],
    "write": []
  }
}
